# Copy sang .env rồi điền giá trị thật. .env không commit (xem .gitignore).

# Neon Postgres (hoặc Postgres bất kỳ). DATABASE_URL nên là connection pooled
# (PgBouncer) nếu deploy serverless; DIRECT_URL dùng riêng cho Prisma Migrate.
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:pass@host.region.aws.neon.tech/neondb?sslmode=require"

# Domain dùng cho canonical URL / OG image / sitemap (src/lib/site.ts). Không set thì
# lấy VERCEL_PROJECT_PRODUCTION_URL, không có nữa thì fallback domain demo.
NEXT_PUBLIC_SITE_URL=""

# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
